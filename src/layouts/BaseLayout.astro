---
import '../styles/site.css';
const { frontmatter, title, description, published } = Astro.props;
const pageTitle = title ?? frontmatter?.title;
const summary =
  description ??
  frontmatter?.description ??
  'A workshop notebook about small tools, odd hardware, and the things they teach me.';
const segment = Astro.url.pathname.split('/')[1];
const is404 = segment === '404' || segment === '404.html';
const fullTitle = pageTitle ? `${pageTitle} · Hydro Log` : 'Hydro Log';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL('/social-card.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    <meta name="author" content="Hydro" />
    <meta
      name="theme-color"
      content="#f6f5ed"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111918"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/hydro.svg" />
    <title>{fullTitle}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Hydro Log"
      href="/rss.xml"
    />
    {
      is404 ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <meta property="og:site_name" content="Hydro Log" />
          <meta
            property="og:type"
            content={published ? 'article' : 'website'}
          />
          <meta property="og:title" content={fullTitle} />
          <meta property="og:description" content={summary} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={socialImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta
            property="og:image:alt"
            content="Hydro Log · A workshop notebook"
          />
          <meta name="twitter:card" content="summary_large_image" />
          {published && (
            <meta
              property="article:published_time"
              content={published.toISOString()}
            />
          )}
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Hydro Log home">
        <img src="/hydro.svg" alt="" width="24" height="24" /> Hydro Log
      </a>
      <nav aria-label="Main">
        <a
          href="/posts/"
          aria-current={segment === 'posts' || segment === 'post'
            ? 'true'
            : undefined}>Posts</a
        >
        <a
          href="/about/"
          aria-current={segment === 'about' ? 'page' : undefined}>About</a
        >
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <a href="/rss.xml">Follow by RSS</a>
      <a href="https://github.com/hydrozerv">Hydro on GitHub</a>
    </footer>
  </body>
</html>
