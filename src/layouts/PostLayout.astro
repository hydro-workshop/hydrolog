---
import BaseLayout from './BaseLayout.astro';
import { dateLabel, tagSlug } from '../utils/common';
const { title, description, tags, date, archived } = Astro.props;
---

<BaseLayout {title} {description}>
  <a class="back" href={archived ? '/archive/' : '/posts/'}
    >← {archived ? 'Archive' : 'All posts'}</a
  >
  <article>
    <header>
      <h1>{title}</h1>
      <time datetime={dateLabel(date)}>{dateLabel(date)}</time>
      {archived && <p class="archive-note">Archived post</p>}
    </header>
    <slot />
    {
      !archived && tags.length > 0 && (
        <footer class="tags" aria-label="Tags">
          {tags.map((tag: string) => (
            <a href={`/posts/${tagSlug(tag)}/`}>#{tag}</a>
          ))}
        </footer>
      )
    }
  </article>
</BaseLayout>
