---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts, tagsFor, tagSlug } from '../../utils/common';
export async function getStaticPaths() {
  const posts = await publishedPosts();
  const tags = tagsFor(posts);
  const slugs = tags.map(tagSlug);
  if (slugs.some((slug) => !slug) || new Set(slugs).size !== slugs.length) {
    throw new Error(
      'Published post tags must produce unique, non-empty URL slugs.',
    );
  }
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`}>
  <a class="back" href="/posts/">← All posts</a>
  <h1>#{tag}</h1>
  <PostList {posts} />
</BaseLayout>
