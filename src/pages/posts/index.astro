---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts, tagsFor, tagSlug } from '../../utils/common';
const posts = await publishedPosts();
const tags = tagsFor(posts);
const archive = await publishedPosts(true);
---

<BaseLayout title="Posts">
  <h1>Posts</h1>
  {
    tags.length > 0 && (
      <nav class="tags" aria-label="Filter by tag">
        {tags.map((tag) => (
          <a href={`/posts/${tagSlug(tag)}/`}>#{tag}</a>
        ))}
      </nav>
    )
  }
  <PostList {posts} />
  {
    archive.length > 0 && (
      <p>
        <a href="/archive/">Archive</a>
      </p>
    )
  }
</BaseLayout>
